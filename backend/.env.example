# Environment variables for Outbreak Monitoring. The backend reads real environment
# variables (it does not load .env files itself). Set them in the shell that starts
# uvicorn, e.g. PowerShell:   $env:OUTBREAK_ADMIN_API_KEY = "a-long-random-string"
# Never commit real values.

# --- Access ---------------------------------------------------------------
# Shared secret sent as the X-API-Key header. Needed to submit data and to see
# exact coordinates / plantation names / notes. Unset = writes disabled and
# everyone gets the privacy-limited public view.
OUTBREAK_ADMIN_API_KEY=

# Decimal places kept in coordinates shown to non-key holders (2 = ~1.1 km)
OUTBREAK_PUBLIC_COORD_DECIMALS=2

# --- Database -------------------------------------------------------------
# SQLite file (created and migrated automatically). Default: backend/data/outbreak.db
OUTBREAK_DB_PATH=

# --- Weather --------------------------------------------------------------
# open-meteo (default, no key needed for non-commercial use) or none
WEATHER_PROVIDER=open-meteo
# Commercial Open-Meteo plans: set the key and the customer base URL from your plan
WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_TIMEOUT_S=4

# --- Risk rules -----------------------------------------------------------
# Optional JSON file deep-merged over the defaults in services/risk_config.py
OUTBREAK_RISK_CONFIG=

# Existing variables (unchanged): MSCAF_CHECKPOINT, MSCAF_DEVICE, MSCAF_MAX_UPLOAD_MB, MSCAF_CORS_ORIGINS
